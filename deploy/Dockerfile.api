# ── Soundwave AI — API image ──────────────────────────────────────────────
FROM node:20-alpine AS deps
WORKDIR /app
COPY server/package.json server/package-lock.json* ./
RUN npm ci || npm install

FROM node:20-alpine AS build
WORKDIR /app
COPY server/ .
COPY --from=deps /app/node_modules ./node_modules
RUN npm run prisma:generate && npm run build

FROM node:20-alpine AS runtime
WORKDIR /app
# python3 + requests run the vendored yt-download engine (YouTube import);
# ffmpeg muxes/cuts the downloaded streams.
RUN apk add --no-cache ffmpeg python3 py3-requests
ENV NODE_ENV=production
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY --from=build /app/prisma ./prisma
COPY server/scripts ./scripts
COPY vendor/yt-download ./vendor/yt-download
EXPOSE 4000
CMD ["node", "dist/index.js"]
