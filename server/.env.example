# ── Soundwave AI server configuration ─────────────────────────────
# Copy to .env and fill in. ALL secrets are required in production.
# The server refuses to boot in production if any required value is missing.

NODE_ENV=development
PORT=4000

# PostgreSQL connection string (Prisma). When this points at a reachable
# Postgres instance the server uses the Prisma-backed store; leave it UNSET
# (as below) to use the embedded JSON store for local development.
# DATABASE_URL=postgresql://user:password@localhost:5432/soundwave

# Auth — replace both with your own random values (e.g. `openssl rand -hex 32`).
# In development, if these are missing entirely the server mints ephemeral
# ones and warns (sessions reset on restart); the placeholder values below are
# fine for local use but must never ship to production.
JWT_ACCESS_SECRET=change-me-32-random-bytes
JWT_REFRESH_SECRET=change-me-32-random-bytes
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Comma-separated allowed CORS origins in production (no wildcard).
CORS_ORIGINS=https://app.soundwave.ai

# OAuth (Google / GitHub). Leave blank to disable (buttons then explain
# "not configured"). Authorized redirect URIs must be set to:
#   http://localhost:5173/api/v1/auth/oauth/google/callback
#   http://localhost:5173/api/v1/auth/oauth/github/callback
# (replace the origin with APP_URL in production)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_ENTERPRISE_MONTHLY=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM="Soundwave AI <no-reply@soundwave.ai>"
APP_URL=http://localhost:5173

# Storage (S3-compatible: AWS S3 / Cloudflare R2 / MinIO)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Optional local FFmpeg binary path (vendored binary is auto-detected otherwise)
FFMPEG_PATH=
